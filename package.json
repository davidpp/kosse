{
  "name": "kosse-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidpp/kosse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "app": "bun scripts/app.ts",
    "build": "cargo build --release --locked -p kosse",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && cargo build --release --locked -p kosse",
    "test": "cargo nextest run --workspace --locked && cargo test --doc --workspace --locked",
    "test:window": "bun scripts/window-test.ts",
    "release:local": "bun scripts/release-local.ts",
    "install:local": "bun scripts/install-local.ts",
    "uninstall:local": "bun scripts/uninstall-local.ts",
    "test:package": "bun run release:local && cargo build --locked -p kosse-fixtures --bins && bun scripts/package-test.ts",
    "lint": "oxlint --deny-warnings && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt --all && oxfmt",
    "fmt:check": "cargo fmt --all --check && oxfmt --check",
    "contracts": "KOSSE_UPDATE_CONTRACTS=1 cargo nextest run --locked -p kosse-core --test contracts --test profile_schema",
    "audit": "cargo deny check && zizmor --offline .github"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
